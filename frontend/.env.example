# Copy to .env.local and fill in. Only VITE_-prefixed vars are exposed to the browser.
# Never put secrets here — everything below ships in the client bundle.

# Base path/URL for the FastAPI backend, incl. version. Keep /api/v1 in dev to use the Vite proxy.
VITE_API_BASE_URL=/api/v1

# Dev-server only: where Vite proxies /api and /static (FastAPI). No VITE_ prefix = never
# exposed to the browser bundle.
API_PROXY_TARGET=http://localhost:8000

# Google OAuth client ID for "Continue with Google".
VITE_GOOGLE_CLIENT_ID=
