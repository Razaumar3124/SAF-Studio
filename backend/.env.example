# Application Settings
APP_NAME=SAF Studio API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# MongoDB Configuration
# For local development: mongodb://localhost:27017 or mongodb://127.0.0.1:27017
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=saf_studio
MONGODB_TIMEOUT_MS=5000

# CORS Configuration (JSON array of allowed origins)
# In development, Vite frontend runs at http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Authentication & Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-saf-studio-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Refresh Cookie Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_PHOTO_UPLOAD_MAX_ATTEMPTS=30
RATE_LIMIT_PHOTO_UPLOAD_WINDOW_SECONDS=3600

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=saf-studio-photos
R2_CUSTOM_DOMAIN=
R2_ENDPOINT_URL=
R2_MAX_UPLOAD_MB=25

# Business WhatsApp Quote Requests & Digital Reports (Phase 7)
BUSINESS_WHATSAPP_NUMBER=919876543210
PUBLIC_APP_URL=http://localhost:5173
QUOTE_SHARE_EXPIRY_DAYS=30

# Groq AI Creative Curator (Optional - app functions 100% without Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=false
GROQ_TIMEOUT_SECONDS=10
GROQ_MAX_OUTPUT_TOKENS=256
GROQ_DAILY_REQUEST_LIMIT=100
GROQ_DAILY_TOKEN_BUDGET=50000

# Transactional Email & Password Recovery (Resend)
# Use 'mock' for offline development and testing, 'resend' for live delivery
EMAIL_PROVIDER=mock
# Required when EMAIL_PROVIDER=resend:
RESEND_API_KEY=
# In development, onboarding@resend.dev sends to the registered Resend account owner.
# In production, use your verified domain e.g. "SAF Studio <security@safstudio.com>"
RESEND_FROM_EMAIL=SAF Studio <onboarding@resend.dev>
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_COOLDOWN_SECONDS=60
OTP_SECRET_KEY=
