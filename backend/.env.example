# Application Settings
APP_NAME=SAF Studio API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# MongoDB Configuration
# MongoDB Atlas (Cloud Database - M0 Free Tier / Production):
# Format: mongodb+srv://<username>:<url_encoded_password>@<cluster-subdomain>.mongodb.net/saf_studio?retryWrites=true&w=majority&appName=SAFStudio
# Note: If your password contains special characters (such as @, :, /, ?, #), you must URL-encode it using urllib.parse.quote_plus(password).
# Example: python -c "import urllib.parse; print(urllib.parse.quote_plus('P@ss#w0rd'))"
#
# Local MongoDB Development (fallback):
# MONGODB_URL=mongodb://localhost:27017
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/saf_studio?retryWrites=true&w=majority&appName=SAFStudio
DATABASE_NAME=saf_studio
MONGODB_TIMEOUT_MS=10000

# CORS Configuration (JSON array of allowed origins)
# In development, Vite frontend runs at http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Authentication & Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-saf-studio-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Refresh Cookie Security
# Production forces Secure=true. Use SAME-SITE hosts (e.g. app.example.com + api.example.com)
# with COOKIE_SAMESITE=lax. Cross-site hosts (*.pages.dev + *.onrender.com) need
# COOKIE_SAMESITE=none, which browsers only accept over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Reverse proxy trust. 0 = ignore X-Forwarded-For (local dev). Render sits in front of the app: set 1.
TRUSTED_PROXY_HOPS=0

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_PHOTO_UPLOAD_MAX_ATTEMPTS=30
RATE_LIMIT_PHOTO_UPLOAD_WINDOW_SECONDS=3600

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=saf-studio-photos
R2_CUSTOM_DOMAIN=
R2_ENDPOINT_URL=
# Photos: accept uploads up to 15 MB (hard maximum); stored as a compressed WebP master <= 2 MB
PHOTO_MAX_UPLOAD_MB=15
PHOTO_MASTER_MAX_BYTES=2000000
PHOTO_MASTER_MAX_EDGE_PX=4096
# Free-tier safeguards: hard cap on total R2 storage (9.9 GB) and per-user photo library size
R2_STORAGE_HARD_CAP_BYTES=9900000000
USER_PHOTO_STORAGE_LIMIT_MB=250
# Background cleanup of unreferenced R2 objects + ledger reconciliation (0 disables)
STORAGE_ORPHAN_GRACE_HOURS=24
# 0 = no in-process loop (recommended on Render: run scripts/storage_maintenance.py as a Cron Job)
STORAGE_MAINTENANCE_INTERVAL_HOURS=0

# Business WhatsApp Quote Requests & Digital Reports (Phase 7)
BUSINESS_WHATSAPP_NUMBER=919876543210
PUBLIC_APP_URL=http://localhost:5173
QUOTE_SHARE_EXPIRY_DAYS=30

# MongoDB growth limits (Atlas M0: 512 MB)
DESIGN_VERSION_RETENTION=20
DESIGN_PURGE_AFTER_DAYS=30
RATE_LIMIT_DESIGN_CREATE_MAX_ATTEMPTS=60
RATE_LIMIT_DESIGN_VERSION_MAX_ATTEMPTS=120

# Groq AI Creative Curator (Optional - app functions 100% without Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=false
GROQ_TIMEOUT_SECONDS=10
GROQ_MAX_OUTPUT_TOKENS=256
GROQ_DAILY_REQUEST_LIMIT=100
GROQ_DAILY_TOKEN_BUDGET=50000

# Transactional Email & Password Recovery (Resend)
# Use 'mock' for offline development and testing, 'resend' for live delivery
EMAIL_PROVIDER=mock
# Required when EMAIL_PROVIDER=resend:
RESEND_API_KEY=
# In development, onboarding@resend.dev sends to the registered Resend account owner.
# In production, use your verified domain e.g. "SAF Studio <security@safstudio.com>"
RESEND_FROM_EMAIL=SAF Studio <onboarding@resend.dev>
RESEND_TEST_MODE=true
# The Resend account owner's inbox (the only allowed recipient while RESEND_TEST_MODE=true)
RESEND_TEST_RECIPIENT=
# Resend free tier: 100 emails/day (UTC), 3,000/month; at most 5 codes per address per day
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
EMAIL_PER_RECIPIENT_DAILY_LIMIT=5
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_COOLDOWN_SECONDS=60
OTP_SECRET_KEY=

# ---------------------------------------------------------------------------------------------
# PRODUCTION (Render) - the app refuses to start with ENVIRONMENT=production unless these hold.
# Set these as Render environment variables (not in a committed file). Values shown are placeholders.
#   ENVIRONMENT=production
#   DEBUG=false
#   SECRET_KEY=<output of: python -c "import secrets; print(secrets.token_urlsafe(48))">
#   MONGODB_URL=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/saf_studio?retryWrites=true&w=majority
#   CORS_ORIGINS=https://<your-pages-or-app-domain>
#   PUBLIC_APP_URL=https://<your-render-api-domain>
#   TRUSTED_PROXY_HOPS=1
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=lax            # or none, see the cookie notes above
#   GOOGLE_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL=SAF Studio <no-reply@<verified-domain>>
#   RESEND_TEST_MODE=false
#   R2_ACCOUNT_ID=... / R2_ACCESS_KEY_ID=... / R2_SECRET_ACCESS_KEY=...   (bucket-scoped token)

